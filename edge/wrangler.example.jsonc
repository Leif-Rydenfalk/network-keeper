{
  "name": "network-keeper-people",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../app",
    "run_worker_first": [
      "/api/people/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "network-keeper",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
